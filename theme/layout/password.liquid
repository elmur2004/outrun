<!doctype html>
{%- liquid
  assign lang = request.locale.iso_code | slice: 0, 2
  assign dir = 'ltr'
  if lang == 'ar' or lang == 'he' or lang == 'fa' or lang == 'ur'
    assign dir = 'rtl'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#05070A">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else %}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif %}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <script>
      (function (d) {
        d.classList.add('js');
        var calm = null;
        try { calm = JSON.parse(localStorage.getItem('or_calm')); } catch (e) {}
        if (calm === null) calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (calm) d.classList.add('calm');
      })(document.documentElement);
    </script>

    {% render 'font-faces' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="pw-body">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
