{{ 'section-made-here.css' | asset_url | stylesheet_tag }}

<section class="mh-hero dark black">
  {% render 'image', image: section.settings.image, fallback: 'ph-workshop.jpg', alt: section.settings.image_alt, class: 'mh-img', eager: true %}
  {%- if section.settings.glow_word != blank -%}
    <div class="glow-word reveal bgw latin" aria-hidden="true">{{ section.settings.glow_word | escape }}</div>
  {%- endif -%}
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.lead != blank -%}
      <p class="lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Workshop hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Full-bleed, darkened. At least 2400 × 1350 px." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "CAD drawings of the cap on screen beside a 3D printer in the OUTRUN workshop" },
    { "type": "text", "id": "glow_word", "label": "Glow word", "default": "WORKSHOP" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made Here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted in our own workshop." },
    { "type": "textarea", "id": "lead", "label": "Text", "default": "Design, build, finish and test, under one roof. Shown, never shouted." }
  ],
  "presets": [{ "name": "Workshop hero" }]
}
{% endschema %}
