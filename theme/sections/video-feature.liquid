{{ 'section-made-here.css' | asset_url | stylesheet_tag }}

<section class="sec">
  <div class="wrap">
    <button class="film" type="button" data-film aria-label="{{ 'accessibility.play_video' | t }}: {{ section.settings.heading | escape }}">
      {% render 'image', image: section.settings.poster, fallback: 'ph-carrear.jpg', sizes: '(max-width: 1320px) 100vw, 1320px' %}
      <span class="ov">
        <span class="ov-tx">
          <span class="label">{{ section.settings.label | escape }}</span>
          <b>{{ section.settings.heading | escape }}</b>
        </span>
        <span class="play-round" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
      </span>
      {%- if section.settings.video != blank -%}
        <template>
          {{
            section.settings.video
            | video_tag: class: 'film-video', controls: true, playsinline: true, preload: 'metadata', image_size: '1600x'
          }}
        </template>
      {%- endif -%}
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Workshop film",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "16:9. Plays in place, with controls, when the poster is clicked." },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Shown until the video plays. 16:9." },
    { "type": "text", "id": "label", "label": "Label", "default": "Workshop film" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The build, from CAD to the road" }
  ],
  "presets": [{ "name": "Workshop film" }]
}
{% endschema %}
