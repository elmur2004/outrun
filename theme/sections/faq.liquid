{{ 'section-faq.css' | asset_url | stylesheet_tag }}

<section class="sec{% if section.settings.background == 'air' %} pattern-air{% endif %}">
  <div class="wrap faq-grid">
    <div class="faq-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}<i aria-hidden="true"></i></summary>
          <div class="faq-a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight answers." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "air", "label": "Air pattern" }
      ],
      "default": "air"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does the cap stay level?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>A sealed bearing lets the face turn free of the wheel. A counterweight under the emblem keeps it upright, so the logo reads level at any speed.</p>"
        }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
