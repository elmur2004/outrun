{{ 'section-craft-strip.css' | asset_url | stylesheet_tag }}

<section class="sec">
  <div class="wrap">
    <div class="sec-head rv">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="craft">
      {%- for block in section.blocks -%}
        {%- liquid
          case forloop.index
            when 1
              assign fallback = 'ph-workshop.jpg'
            when 2
              assign fallback = 'ph-caliper.jpg'
            when 3
              assign fallback = 'ph-boxcaps.jpg'
            else
              assign fallback = 'ph-carrear.jpg'
          endcase
        -%}
        <article class="rv" {{ block.shopify_attributes }}>
          <figure>
            {% render 'image',
              image: block.settings.image,
              fallback: fallback,
              sizes: '(max-width: 520px) 100vw, (max-width: 900px) 50vw, 25vw'
            %}
          </figure>
          <div class="body">
            <span class="n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Craft strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The craft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted in our own workshop." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Inside the workshop" },
    { "type": "url", "id": "link", "label": "Link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "4:3" },
        { "type": "text", "id": "title", "label": "Title", "default": "Design" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every piece starts in CAD." }
      ]
    }
  ],
  "presets": [{ "name": "Craft strip" }]
}
{% endschema %}
