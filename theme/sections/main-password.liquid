{{ 'section-password.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign message = section.settings.text
  if shop.password_message != blank
    assign message = shop.password_message
  endif
-%}
<section class="pw dark black">
  {%- if section.settings.glow_word != blank -%}
    <div class="glow-word reveal pw-bgw latin" aria-hidden="true">{{ section.settings.glow_word | escape }}</div>
  {%- endif -%}
  <i class="streak pw-streak" aria-hidden="true"></i>

  <header class="pw-top wrap">
    <span class="pw-logo">{% render 'logo', label: shop.name %}</span>
    {% render 'language-switch', style: 'pill' %}
  </header>

  <div class="pw-main wrap">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h1 class="pw-h latin">
      {{- section.settings.heading | escape }}
      {% if section.settings.heading_glow != blank -%}
        <span class="glowing">{{ section.settings.heading_glow | escape }}</span>
      {%- endif -%}
    </h1>
    {%- if message != blank -%}
      <p class="lead">{{ message | escape }}</p>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: 'PasswordSignup', class: 'pw-signup' -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.signup_tag | escape }}">
        {%- if form.posted_successfully? -%}
          <p class="pw-msg" role="status">{% render 'icon', name: 'check' %}<span>{{ 'password.signup_success' | t }}</span></p>
        {%- else -%}
          <label class="visually-hidden" for="PasswordSignup-email">{{ 'notify.email' | t }}</label>
          <div class="pw-row">
            <input
              class="input"
              type="email"
              id="PasswordSignup-email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'password.email_placeholder' | t }}"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="PasswordSignup-error"
              {% endif %}
            >
            <button class="btn solid" type="submit">
              {{- 'password.signup_button' | t }}
              {% render 'icon', name: 'arrow' -%}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="pw-msg pw-msg--error" id="PasswordSignup-error" role="alert">
              {%- render 'icon', name: 'alert' -%}
              <span>{{ 'notify.error' | t }}</span>
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- comment -%} Open the fold-out if a wrong password was just submitted. {%- endcomment -%}
    {%- capture password_form -%}
      {%- form 'storefront_password', id: 'PasswordForm', class: 'pw-password' -%}
        <label class="label" for="PasswordForm-password">{{ 'password.label' | t }}</label>
        <div class="pw-row">
          <input
            class="input"
            type="password"
            id="PasswordForm-password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="PasswordForm-error"
            {% endif %}
          >
          <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="pw-msg pw-msg--error" id="PasswordForm-error" role="alert">
            {%- render 'icon', name: 'alert' -%}
            <span>{{ 'password.wrong' | t }}</span>
          </p>
        {%- endif -%}
      {%- endform -%}
    {%- endcapture -%}
    <details class="pw-enter" {% if password_form contains 'PasswordForm-error' %}open{% endif %}>
      <summary class="link">{{ 'password.toggle' | t }}</summary>
      {{ password_form }}
    </details>
  </div>

  <footer class="pw-foot wrap">
    <span class="latin">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · {{ section.settings.descriptor | escape }}</span>
    <span>{{ 'password.owner' | t }} <a href="/admin" class="pw-admin">{{ 'password.login' | t }}</a></span>
  </footer>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown while the store is password-protected. The message from Online Store → Preferences replaces the text below when it's set."
    },
    { "type": "text", "id": "glow_word", "label": "Glow word", "default": "SOON" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 · Opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drive the" },
    { "type": "text", "id": "heading_glow", "label": "Heading, glowing end", "default": "feeling." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Floating center caps, finished to the smallest detail. Leave your email and we’ll tell you once, when the drop opens."
    },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    {
      "type": "text",
      "id": "signup_tag",
      "label": "Customer tag for signups",
      "info": "Find these subscribers in Customers by filtering on this tag.",
      "default": "drop-01-launch"
    },
    { "type": "text", "id": "descriptor", "label": "Footer line", "default": "Exclusive Motion Gear" }
  ]
}
{% endschema %}
