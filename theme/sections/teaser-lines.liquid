{{ 'section-teaser-lines.css' | asset_url | stylesheet_tag }}

<section class="sec dark">
  <div class="wrap">
    <div class="sec-head rv">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.lead != blank -%}
        <p class="lead">{{ section.settings.lead | escape }}</p>
      {%- endif -%}
    </div>

    <div class="next-grid">
      {%- for block in section.blocks -%}
        {%- if forloop.index == 1 -%}
          {%- assign fallback = 'ph-ride.jpg' -%}
        {%- else -%}
          {%- assign fallback = 'ph-kart.jpg' -%}
        {%- endif -%}
        <article class="veil" data-veil {{ block.shopify_attributes }}>
          {% render 'image', image: block.settings.image, fallback: fallback, class: 'veil-dark', sizes: '(max-width: 760px) 100vw, 50vw' %}
          {% render 'image',
            image: block.settings.image,
            fallback: fallback,
            class: 'veil-lit',
            alt: block.settings.alt,
            sizes: '(max-width: 760px) 100vw, 50vw'
          %}
          <span class="cover" aria-hidden="true"></span>
          <div class="meta">
            <div class="meta-tx">
              <span class="phase">{{ block.settings.phase | escape }}</span>
              <h3 class="latin">{{ block.settings.name | escape }}</h3>
              <span class="caption">{{ block.settings.caption | escape }}</span>
            </div>
            {%- if block.settings.link_label != blank -%}
              <a class="btn sm" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coming next teaser",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One name. Three lines." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Car is live. Ride and Kart are next." },
    { "type": "textarea", "id": "lead", "label": "Text", "default": "Lines open in order, never all at once." }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "Product line",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Silhouette image", "info": "Revealed by a light sweep as visitors scroll." },
        { "type": "text", "id": "alt", "label": "Image description", "default": "Silhouette of the upcoming OUTRUN Ride e-scooter" },
        { "type": "text", "id": "phase", "label": "Phase", "default": "Phase two" },
        { "type": "text", "id": "name", "label": "Name", "default": "OUTRUN Ride" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "E-scooters, e-skateboards and hoverboards." },
        { "type": "text", "id": "link_label", "label": "Button label", "default": "Notify me" },
        { "type": "url", "id": "link", "label": "Button link", "default": "/collections/all" }
      ]
    }
  ],
  "presets": [{ "name": "Coming next teaser" }]
}
{% endschema %}
