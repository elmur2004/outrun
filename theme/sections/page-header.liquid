{{ 'section-page-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  assign lead = section.settings.lead
  if heading == blank
    if collection.title
      assign heading = collection.title
    elsif page.title
      assign heading = page.title
    elsif template.name == 'search'
      assign heading = 'search.title' | t
    elsif template.name == 'list-collections'
      assign heading = shop.name
    endif
  endif
  if lead == blank and collection.description != blank
    assign lead = collection.description | strip_html | truncatewords: 40
  endif
-%}
<section class="phead dark night">
  {%- if section.settings.glow_word != blank -%}
    <div class="glow-word reveal bgw latin" aria-hidden="true">{{ section.settings.glow_word | escape }}</div>
  {%- endif -%}
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h1>{{ heading | escape }}</h1>
    {%- if lead != blank -%}
      <p class="lead">{{ lead | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "glow_word", "label": "Glow word", "default": "CAR" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUTRUN Car" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the collection or page title."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Text",
      "info": "Leave empty to use the collection description."
    }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
