{{ 'section-editions.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'editions.js' | asset_url }}"></script>

{%- liquid
  assign active = section.settings.active | plus: 0 | minus: 1
  if active >= section.blocks.size or active < 0
    assign active = 0
  endif
  assign active_block = section.blocks[active]
-%}
<editions-showcase class="sec editions dark black">
  <div class="wrap sec-head rv">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.lead != blank -%}
      <p class="lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}
  </div>

  <div class="ed-stage">
    <div class="cv-wrap">
      {% render 'image', image: section.settings.image, fallback: 'ph-boxcaps.jpg', class: 'fallback' %}
      <canvas aria-hidden="true"></canvas>
    </div>
  </div>

  <div class="wrap">
    <div class="ed-tabs">
      {%- for block in section.blocks -%}
        {%- assign link = block.settings.link | default: section.settings.link -%}
        <button
          class="ed-tab"
          type="button"
          data-ed-tab
          data-emblem="{{ block.settings.emblem }}"
          data-url="{{ link }}"
          data-link-label="{{ 'editions.shop' | t: edition: block.settings.name | escape }}"
          aria-pressed="{% if forloop.index0 == active %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="k">{{ 'editions.edition' | t }} · {{ block.settings.status | escape }}</span>
          <h3 class="latin">{{ block.settings.name | escape }}</h3>
          <p>{{ block.settings.caption | escape }}</p>
        </button>
      {%- endfor -%}
    </div>
    {%- if active_block -%}
      <div class="ed-foot">
        <a class="link" data-ed-link href="{{ active_block.settings.link | default: section.settings.link }}">
          {{- 'editions.shop' | t: edition: active_block.settings.name -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</editions-showcase>

{% schema %}
{
  "name": "Editions",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three editions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick the face that rides with you." },
    { "type": "textarea", "id": "lead", "label": "Text", "default": "Same floating build. Three faces. Hover or tap a cap to bring it forward." },
    {
      "type": "range",
      "id": "active",
      "label": "Edition shown first",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    { "type": "url", "id": "link", "label": "Default link", "info": "Used when an edition has no link of its own.", "default": "/collections/all" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown before the 3D caps load, and instead of them when 3D is off."
    }
  ],
  "blocks": [
    {
      "type": "edition",
      "name": "Edition",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Signature" },
        { "type": "text", "id": "status", "label": "Status", "default": "Launch" },
        { "type": "textarea", "id": "caption", "label": "Caption", "default": "The OUTRUN symbol. Two speed lines." },
        {
          "type": "select",
          "id": "emblem",
          "label": "3D emblem face",
          "options": [
            { "value": "street", "label": "Street (car badge)" },
            { "value": "signature", "label": "Signature (OUTRUN symbol)" },
            { "value": "custom", "label": "Custom (your design)" }
          ],
          "default": "signature"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Editions" }]
}
{% endschema %}
