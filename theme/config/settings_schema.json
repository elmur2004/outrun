      { "type": "header", "content": "Item 4" },
      {
        "type": "select",
        "id": "trust_4_icon",
        "label": "Icon",
        "options": [
          { "value": "box", "label": "Box" },
          { "value": "swap", "label": "Exchange" },
          { "value": "shield", "label": "Shield" },
          { "value": "chat", "label": "Chat" }
        ],
        "default": "chat"
      },
      { "type": "text", "id": "trust_4_title", "label": "Title", "default": "Real people" },
