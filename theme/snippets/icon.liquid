{% doc %}
  Line icons from the design (stroke 1.2–1.3, no fill). Decorative: always aria-hidden.

  @param {string} name - wheel | menu | close | arrow | play | pause | box | swap | shield | chat
  @param {string} [class] - extra CSS class
{% enddoc %}
{%- case name -%}
  {%- when 'wheel' -%}
    <svg class="wheel {{ class }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10.5"/><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 5v5M12 14v5M5 12h5M14 12h5M7.1 7.1l3.5 3.5M13.4 13.4l3.5 3.5M16.9 7.1l-3.5 3.5M10.6 13.4l-3.5 3.5"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M3 8h18M3 16h12"/></svg>
  {%- when 'close' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'arrow' -%}
    <svg class="arr {{ class }}" viewBox="0 0 22 10" width="22" height="10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" focusable="false"><path d="M0 5h20M16 1l4 4-4 4"/></svg>
  {%- when 'play' -%}
    <svg class="{{ class }}" viewBox="0 0 12 12" width="12" height="12" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 2l7 4-7 4z"/></svg>
  {%- when 'pause' -%}
    <svg class="{{ class }}" viewBox="0 0 12 12" width="12" height="12" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 2h2v8H3zM7 2h2v8H7z"/></svg>
  {%- when 'box' -%}
    <svg class="{{ class }}" viewBox="0 0 26 26" width="26" height="26" aria-hidden="true" focusable="false"><path d="M3 8l10-5 10 5v10l-10 5-10-5z"/><path d="M3 8l10 5 10-5M13 13v10M8 5.5l10 5"/></svg>
  {%- when 'swap' -%}
    <svg class="{{ class }}" viewBox="0 0 26 26" width="26" height="26" aria-hidden="true" focusable="false"><path d="M4 9h17l-4-4M22 17H5l4 4"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" viewBox="0 0 26 26" width="26" height="26" aria-hidden="true" focusable="false"><path d="M13 3l8 3v7c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 13l3 3 5-6"/></svg>
  {%- when 'chat' -%}
    <svg class="{{ class }}" viewBox="0 0 26 26" width="26" height="26" aria-hidden="true" focusable="false"><path d="M4 12a9 8 0 1 1 4 6.6L4 21l1.2-4A8 8 0 0 1 4 12z"/><path d="M9 11h8M9 14h5"/></svg>
{%- endcase -%}
