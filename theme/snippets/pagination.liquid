{% doc %}
  Previous / numbered / next page links. Renders nothing when there's one page.

  @param {object} paginate - the paginate object
{% enddoc %}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a class="chip" href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">←</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="chip num" href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="chip num" aria-current="page" aria-pressed="true">{{ part.title }}</span>
      {%- else -%}
        <span class="chip num">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="chip" href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">→</a>
    {%- endif -%}
  </nav>
{%- endif -%}
