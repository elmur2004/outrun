{% doc %}
  Self-hosted brand fonts: @font-face rules plus preloads. Render once inside <head>.

  - Chakra Petch (300-700) covers all Latin text, in English and in Arabic pages.
  - Changa (variable, wght 200-800) only covers Arabic characters (unicode-range), so English
    pages never download it. Use one stack everywhere and the browser picks per character:
    font-family: "Chakra Petch", "Changa", "Segoe UI", system-ui, sans-serif;
  - Shopify's font library can't be used: it has no Changa and no Arabic glyphs.

  Generated by tools/build-brand-assets.py. Edit the script, not this file.
{% enddoc %}
{%- liquid
  assign lang = request.locale.iso_code | slice: 0, 2
-%}
{{ 'chakra-petch-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- if lang == 'ar' %}
{{ 'changa-arabic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- else %}
{{ 'chakra-petch-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
{%- endif %}
<style>
  @font-face { font-family: "Chakra Petch"; font-style: normal; font-weight: 300; font-display: swap;
    src: url({{ 'chakra-petch-300.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Chakra Petch"; font-style: normal; font-weight: 400; font-display: swap;
    src: url({{ 'chakra-petch-400.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Chakra Petch"; font-style: normal; font-weight: 500; font-display: swap;
    src: url({{ 'chakra-petch-500.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Chakra Petch"; font-style: normal; font-weight: 600; font-display: swap;
    src: url({{ 'chakra-petch-600.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Chakra Petch"; font-style: normal; font-weight: 700; font-display: swap;
    src: url({{ 'chakra-petch-700.woff2' | asset_url }}) format("woff2"); }
  @font-face { font-family: "Changa"; font-style: normal; font-weight: 200 800; font-display: swap;
    src: url({{ 'changa-arabic.woff2' | asset_url }}) format("woff2");
    unicode-range: U+0600-06FF, U+0750-077F, U+0870-08FF, U+200C-200F, U+2010-2011, U+204F, U+25CC, U+2E41, U+FB50-FDFF, U+FE70-FEFF; }
</style>
